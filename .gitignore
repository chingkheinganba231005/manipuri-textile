# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Data, checkpoints and outputs (large / possibly sensitive - never commit raw community data).
# Patterns are anchored to the repository root so that e.g. src/manitex/data/ is not ignored.
/data/*
!/data/README.md
/runs/
/checkpoints/
/outputs/
/exports/
/wandb/
*.ckpt
*.pt
*.safetensors

# Space build output
/space_build/

# LaTeX intermediates
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.log
/paper/*.out
/paper/*.fls
/paper/*.fdb_latexmk
/paper/*.synctex.gz

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
